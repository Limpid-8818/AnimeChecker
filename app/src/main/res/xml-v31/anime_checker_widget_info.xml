<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="@dimen/anime_checker_widget_min_width"
    android:minHeight="@dimen/anime_checker_widget_min_height"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="@dimen/anime_checker_widget_min_resize_width"
    android:minResizeHeight="@dimen/anime_checker_widget_min_resize_height"
    android:maxResizeWidth="@dimen/anime_checker_widget_max_resize_width"
    android:maxResizeHeight="@dimen/anime_checker_widget_max_resize_height"
    android:updatePeriodMillis="1800000"
    android:targetCellWidth="@integer/anime_checker_widget_target_cell_width"
    android:targetCellHeight="@integer/anime_checker_widget_target_cell_height"
    android:description="@string/widget_description"
    android:previewImage="@drawable/anime_checker_widget_preview_image"
    android:previewLayout="@layout/anime_checker_widget_preview">
</appwidget-provider>
